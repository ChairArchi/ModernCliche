{
  "name": "Modern Cliche Research",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postAttachCommand": {
    "server": "python -m streamlit run streamlit_app.py --server.address 0.0.0.0"
  },
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "Modern Cliche",
      "onAutoForward": "openPreview"
    }
  }
}
